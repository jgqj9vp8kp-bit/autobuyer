# ---- Источник данных по кампаниям (дашборд баеров) ----
CAPSULED_API_URL=https://capsuled.space/api/external/v1
CAPSULED_API_KEY=

# ---- PostHog (воронка) ----
# Self-hosted или облако (https://eu.posthog.com / https://us.posthog.com)
POSTHOG_HOST=https://ph.app-inkfolio-reader.pro
POSTHOG_PROJECT_ID=1
# Personal API key с правом query:read (Settings → User → Personal API keys)
POSTHOG_API_KEY=
# HogQL-выражение привязки события к кампании; пусто = coalesce(utm_campaign события, $initial_utm_campaign персоны)
POSTHOG_CAMPAIGN_EXPR=

# ---- Режим данных ----
# demo  — синтетические данные (работает без ключей)
# live  — реальные источники; если источник недоступен, падает на demo с пометкой в UI
DATA_MODE=demo

# ---- Доступ (обязательно для публичного деплоя) ----
# Пока BASIC_AUTH_PASSWORD пуст, приложение открыто. Логин можно не задавать — тогда подойдёт любой.
BASIC_AUTH_USER=team
BASIC_AUTH_PASSWORD=

# ---- Где хранить конфиги правил и кеш (в Docker — том /data) ----
DATA_DIR=
