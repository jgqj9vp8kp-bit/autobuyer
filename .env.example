# ---- Источник данных по кампаниям (дашборд баеров) ----
CAPSULED_API_URL=https://capsuled.space/api/external/v1
CAPSULED_API_KEY=

# ---- PostHog (воронка) ----
# Например https://eu.posthog.com или https://us.posthog.com (или self-hosted)
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
# Personal API key с правом query:read
POSTHOG_API_KEY=

# ---- Режим данных ----
# demo  — синтетические данные (работает без ключей)
# live  — реальные источники; если источник недоступен, падает на demo с пометкой в UI
DATA_MODE=demo
